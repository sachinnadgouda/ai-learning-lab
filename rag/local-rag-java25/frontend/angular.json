{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "local-rag-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["zone.js"],
            "styles": ["src/styles.css"],
            "outputPath": "dist/local-rag-ui"
          },
          "configurations": {
            "production": {"outputHashing": "all", "budgets": [{"type":"initial","maximumWarning":"650kB","maximumError":"1MB"}]}
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {"tsConfig": "tsconfig.spec.json", "buildTarget": "local-rag-ui:build", "runner": "vitest"}
        }
      }
    }
  },
  "cli": {"analytics": false}
}
