# HTTP Server Configuration
AUDITOR_HOST=127.0.0.1
AUDITOR_PORT=8083
# Required (minimum 16 chars) when running `serve`; NEVER commit real secrets
AUDITOR_API_KEY=change-me-local-dev-api-key-123456
# Comma-separated directories the HTTP API is allowed to scan
AUDITOR_ALLOWED_ROOTS=./examples
# Optional comma-separated allowed browser origins
AUDITOR_CORS_ORIGINS=

# SQLite Persistence (WAL mode + Flyway migrations)
AUDITOR_DB_PATH=./data/auditor.db

# Bounded Repository Scanner Caps
AUDITOR_MAX_FILES=5000
AUDITOR_MAX_FILE_BYTES=1048576
AUDITOR_MAX_DEPTH=20

# Advisory AI Provider (none | ollama | openai-compatible)
AI_PROVIDER=none
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:3b
AI_API_KEY=
AI_CONNECT_TIMEOUT_MS=5000
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# Logging
AUDITOR_LOG_LEVEL=INFO
