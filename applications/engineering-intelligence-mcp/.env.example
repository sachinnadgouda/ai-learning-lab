# ==============================================================================
# Engineering Intelligence MCP Server Configuration
# ==============================================================================

# Deployment trust boundary:
#   local-stdio   - Single-user local MCP process (two-phase confirmation is a prompt-injection/accident guardrail, not independent human auth)
#   shared-server - Shared multi-user server (requires persistent CONFIRMATION_SECRET >=32 chars, authenticated per-request principal+session for writes, and protected/disabled non-loopback /metrics)
DEPLOYMENT_MODE=local-stdio

# GitHub integration mode:
#   demo - Offline realistic engineering fixtures (no GitHub token required)
#   live - Real GitHub REST API v3 (requires GITHUB_TOKEN and non-empty ALLOWED_REPOS)
GITHUB_MODE=demo

# Required when GITHUB_MODE=live. Use a fine-grained PAT with minimum required scopes.
# Never commit real tokens.
GITHUB_TOKEN=

# GitHub API base URL (override for GitHub Enterprise Server or contract testing)
GITHUB_API_BASE_URL=https://api.github.com

# HTTP timeout (ms) and retry/circuit-breaker tuning for GitHub REST requests
GITHUB_TIMEOUT_MS=10000
GITHUB_MAX_RETRIES=3
GITHUB_MAX_PAGES=5

# Server-side permission enforcement:
#   read-only               - All write tools are unconditionally blocked (default)
#   write-with-confirmation - Write tools require valid two-phase confirmation tokens
PERMISSION_MODE=read-only

# Comma-separated repository allowlist ("owner/repo,org/*").
# Default-deny: an empty ALLOWED_REPOS denies ALL repository access!
# Global wildcards ("*", "*/*", "*/repo") are rejected.
ALLOWED_REPOS=acme-eng/payments-platform

# Explicit opt-in for unrestricted local demo mode ONLY (forbidden in GITHUB_MODE=live or DEPLOYMENT_MODE=shared-server).
ALLOW_UNRESTRICTED_DEMO_REPOS=false

# Local process actor identity recorded in SQLite audit trail (local-stdio mode only; ignored as proof of identity in shared-server mode)
ACTOR_ID=local-developer

# Two-phase confirmation token HMAC secret (ephemeral in local-stdio if omitted; REQUIRED >=32 chars in shared-server)
CONFIRMATION_SECRET=
CONFIRMATION_TTL_SECONDS=300

# Persistent SQLite database path (use ":memory:" for ephemeral runs)
AUDIT_DB_PATH=./data/audit.db

# Optional LLM summarizer behind AiSummarizerPort:
#   none              - Deterministic structured summaries only (default)
#   ollama            - Local Ollama server (/api/chat)
#   openai-compatible - Any OpenAI-compatible chat completions endpoint
AI_PROVIDER=none
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:1b
AI_API_KEY=
AI_TIMEOUT_MS=15000

# Optional localhost HTTP server for /health, /ready, /metrics (HEALTH_PORT=0 disables it by default)
HEALTH_PORT=0
HEALTH_HOST=127.0.0.1
METRICS_ENABLED=true
# Optional bearer/X-Metrics-Token secret (>=16 chars) to protect /metrics; REQUIRED when exposing /metrics on non-loopback in shared-server mode
METRICS_AUTH_TOKEN=

# Logging level: debug | info | warn | error (always emitted as JSON to stderr)
LOG_LEVEL=info
