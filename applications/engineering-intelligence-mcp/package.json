{
  "name": "engineering-intelligence-mcp",
  "version": "1.0.0",
  "description": "Production-grade MCP Server for GitHub Engineering Intelligence with hexagonal architecture, prompt-injection defense, two-phase write confirmation, and SQLite audit logging.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/index.js",
  "bin": {
    "engineering-intelligence-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/evals/runEvals.ts",
    "cli": "tsx src/cli/demo-client.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.26.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.3"
  }
}
