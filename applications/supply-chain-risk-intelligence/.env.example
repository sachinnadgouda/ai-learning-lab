# Server binding
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Persistence (pure-Go SQLite with WAL mode and embedded migrations)
DATABASE_URL=./data/supply_chain.db

# Event Broker: "memory" (bounded channel default) or "redis" (Redis Streams)
EVENT_BROKER=memory
REDIS_ADDR=127.0.0.1:6379
REDIS_STREAM=supply-chain-events
REDIS_GROUP=risk-workers

# Concurrent Worker Pool & Backpressure
QUEUE_CAPACITY=256
WORKER_COUNT=4
MAX_RETRIES=3
RETRY_BASE_MS=50
RETRY_MAX_MS=2000

# Pluggable AI Investigator: "none" (deterministic fallback), "ollama", or "openai"
AI_PROVIDER=none
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:1b
AI_API_KEY=
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2

# Optional operational webhook sink (leave empty to use structured log sink)
ALERT_WEBHOOK_URL=

# Server-side RBAC API keys (replace with strong secrets in production!)
API_KEY_OPERATOR=dev-operator-key
API_KEY_APPROVER=dev-approver-key
API_KEY_ADMIN=dev-admin-key
API_KEY_AI_SERVICE=dev-ai-service-key

# Security & Rate Limiting
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
