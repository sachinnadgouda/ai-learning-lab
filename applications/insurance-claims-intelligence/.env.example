# Insurance Claims Intelligence — Environment Configuration
# Copy to .env for local development. NEVER commit real credentials.

APP_NAME=insurance-claims-intelligence
APP_ENV=development
LOG_LEVEL=INFO

# HTTP Server
HOST=127.0.0.1
PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence (SQLite with WAL mode by default; PostgreSQL supported via Compose)
# Example PostgreSQL URL: postgresql+psycopg://claims:claims@localhost:5432/claims_intel
DATABASE_URL=sqlite:///./data/claims_intel.db
AUTO_MIGRATE=true

# Upload & Parsing Guardrails
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE_CHARS=700
CHUNK_OVERLAP_CHARS=120
TESSERACT_CMD=tesseract
OCR_TIMEOUT_SECONDS=15.0

# Hybrid Retrieval & Grounding Thresholds
RRF_K=60
RRF_BM25_WEIGHT=1.0
RRF_VECTOR_WEIGHT=1.0
QA_MIN_EVIDENCE_SCORE=0.015
QA_MIN_LEXICAL_OVERLAP=0.18
QA_TOP_K=5

# AI Provider Selection: local | ollama | openai_compatible
AI_PROVIDER=local
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_DIM=256

# Ollama Configuration (used when AI_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5

# OpenAI-Compatible Configuration (used when AI_PROVIDER=openai_compatible)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Upstream HTTP Reliability
AI_CONNECT_TIMEOUT_SECONDS=5.0
AI_READ_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
AI_BACKOFF_BASE_SECONDS=0.5

# Server-Side API Keys mapped to Roles (NEVER use default dev keys in production)
ADJUSTER_API_KEY=dev-adjuster-key-change-me
REVIEWER_API_KEY=dev-reviewer-key-change-me
ADMIN_API_KEY=dev-admin-key-change-me
AI_SERVICE_API_KEY=dev-ai-service-key-change-me
