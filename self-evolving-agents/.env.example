# Copy to .env and replace every value marked REQUIRED. Never commit .env.

# REQUIRED: admin token for mutation and AI-inspection APIs (>= 12 characters; the backend refuses to start otherwise).
# Generate one with: openssl rand -hex 24
DEMO_ADMIN_TOKEN=replace-with-a-long-random-local-token

# REQUIRED: PostgreSQL password (AI invocation history and evolution events).
DEMO_DB_PASSWORD=replace-with-a-local-db-password

# REQUIRED: Grafana admin password.
GRAFANA_PASSWORD=replace-with-a-local-password

# AI. DEMO_AI_ENABLED is only the initial default; the runtime flag (UI / PUT /api/v1/flags/ai) overrides it and is stored in Redis.
DEMO_AI_ENABLED=false
# Model used for evolution. Pull it once: docker compose --profile setup run --rm ollama-pull
DEMO_AI_MODEL=qwen2.5:3b
DEMO_AI_ALLOWED_MODELS=qwen2.5:3b
DEMO_AI_TIMEOUT=90s

# Evolution
DEMO_EVOLUTION_INTERVAL_MS=60000
DEMO_BACKEND_CAPACITY=50
DEMO_TRIGGER_ARRIVALS=120

# Browser origins allowed to call the API directly (the bundled Nginx proxy is same-origin and needs none).
DEMO_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Retention for persisted AI invocations and events (ISO-8601 or Spring duration, e.g. 30d)
DEMO_RETENTION_AI=30d
DEMO_RETENTION_EVENTS=30d

# Set to "logstash" for structured JSON logs (Docker Compose default); empty = plain text.
LOG_STRUCTURED_FORMAT=logstash

# Waiting-room tickets not polled within this many seconds are treated as abandoned and expire.
DEMO_QUEUE_TICKET_TTL_SECONDS=10
